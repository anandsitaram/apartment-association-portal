# --- database (Neon OR Supabase; use Supabase's pooled "Transaction pooler" string, port 6543) ---
DATABASE_URL=postgres://...
ADMIN_PASSWORD=choose-a-strong-password   # Super Admin password for the built-in "super-admin" login
# AUTH_SECRET=another-long-random-string  # optional: separate secret for signing login tokens (defaults to ADMIN_PASSWORD)
CRON_SECRET=long-random-string           # strongly recommended once AUTO_BACKUP or REMINDERS are on: without it, /api/cron is callable by anyone

# --- authentication ---
# Optional demo data: on a disposable development database, run `npm run seed:demo`.
# The script creates fictional sample flats, demo.admin, demo.alex, demo.jamie, demo.casey, and one sample month.
# Never use demo credentials or demo data in a production association database.
# Individual Viewer / Admin / Super Admin logins and the Users tab are always on - no flag needed.
# Log in as "super-admin" with ADMIN_PASSWORD above to get Super Admin access, then create Admin and
# Viewer accounts for others from the Users tab (Super Admin itself is never created there).
VIEWER=true              # default: on - app opens straight to read-only public data, no login needed.
                         # false - the login screen is shown immediately; nothing is visible until login.
# IMPORTANT: restart `npm run dev` after changing these values. On Vercel, redeploy after changing Environment Variables.
VIEWER_VIEW=true         # default: on - a logged-in Viewer sees only their own linked flat. false: a Viewer sees overall totals and all months (read only)
LOGIN_RATE_LIMIT=true    # default: on - locks a login for 15 min after 5 wrong passwords. Set false to turn off.
AUDIT_LOG=true           # default: on - records who changed what (Super Admins read it in TOOLS). Set false to turn off.
# REMINDERS=true           # default: off - TOOLS -> Reminders (WhatsApp / e-mail links; sending needs the mail variables)
# AUTO_BACKUP=true         # default: off - daily backup in the database, weekly by e-mail when configured

# --- e-mail through Resend (reminders, weekly backup) ---
# RESEND_API_KEY=re_...
# MAIL_FROM=Owners Association <no-reply@yourdomain.com>
# BACKUP_EMAIL=treasurer@example.com
# BACKUP_KEEP=14

# --- Notifications tab (Email / SMS / WhatsApp) ---
# ENABLE_NOTIFICATION=true  # default: off - master switch for the whole Notifications
                            # feature. false (or unset): the "Notifications" nav item is
                            # hidden from the sidebar for every role, the section can't be
                            # opened by URL/section id either, and no notification (manual
                            # or automatic - tickets, bookings, reminders) is ever sent on
                            # any channel. Set true to turn the feature on; you still need
                            # the mail/Twilio/WhatsApp variables below configured per-channel.
                            # See notes/README.md for how to wire up future channels.

# --- SMS / WhatsApp through Twilio (Notifications tab) ---
# Optional: without these, the Notifications tab still works for Email; SMS
# and WhatsApp sends are simply skipped (logged as failed) until configured.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+1415XXXXXXX      # a Twilio number enabled for SMS
# TWILIO_WHATSAPP_FROM=+1415XXXXXXX    # optional: only if your WhatsApp sender differs from the SMS number above

# --- WhatsApp provider selection ---
# "twilio" (default if only Twilio vars above are set) or "baileys" (the
# self-hosted service in whatsapp-service/ — free, uses your own WhatsApp
# number, but needs a separate always-on host; see whatsapp-service/README.md).
# Leave unset to auto-pick: baileys if WHATSAPP_SERVICE_URL is set, else twilio.
# WHATSAPP_PROVIDER=baileys
# WHATSAPP_SERVICE_URL=https://your-whatsapp-service.up.railway.app
# WHATSAPP_SERVICE_TOKEN=same-token-you-set-in-whatsapp-service/.env

# --- rarely needed ---
# DB_DRIVER=pg             # neon | pg (default: neon for *.neon.tech, pg otherwise)
# Local dev: put these in .env.local, then run: npm run dev

# Keep PostgreSQL TLS certificate verification enabled in production. Set false only for a known private/self-signed setup.
DB_SSL_REJECT_UNAUTHORIZED=true
