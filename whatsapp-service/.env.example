# Port this service listens on
PORT=3100

# Shared secret the main Cedar Grove Residences app must send as "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
WHATSAPP_SERVICE_TOKEN=choose-a-long-random-string

# Optional: where to POST incoming WhatsApp messages (e.g. residents replying).
# WEBHOOK_URL=https://your-cedar-grove-app.vercel.app/api/whatsapp-webhook
# WEBHOOK_TOKEN=another-long-random-string

# Where Baileys stores its login session (creds + keys). Must be on a PERSISTENT
# disk — don't point this at a path that gets wiped on redeploy/restart, or
# you'll need to re-scan the QR code every time.
WHATSAPP_AUTH_DIR=auth

LOG_LEVEL=warn
